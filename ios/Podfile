# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Tickdown' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # fmt 11.0.2 (pinned by RCT-Folly) fails to build with the clang shipped in
    # Xcode 26: inside the consteval basic_format_string constructor the checker
    # is built from a second evaluation of the string literal, so the pointer
    # arithmetic in advance_to() spans two distinct literal objects and is no
    # longer a constant expression. Upstream fix is to feed the checker str_.
    fmt_base_h = File.join(__dir__, 'Pods', 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      contents = File.read(fmt_base_h)
      patched = contents.gsub('parse_format_string<true>(str_, checker(s));',
                              'parse_format_string<true>(str_, checker(str_));')
      if patched != contents
        File.write(fmt_base_h, patched)
        Pod::UI.puts 'Patched fmt/base.h for Xcode 26 consteval error'.green
      end
    end
  end
end
